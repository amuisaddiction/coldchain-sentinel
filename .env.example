# ==============================================================================
# ColdChain Sentinel - Environment Configuration Schema
# Copy this file to .env and fill in your actual development credentials.
# NEVER commit .env to version control.
# ==============================================================================

# Application & Environment
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-string
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Persistence & Database
# Local development default: SQLite
DATABASE_URL=sqlite:///./coldchain.db
# Production / Staging example:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/coldchain_db

# File Evidence Storage
# Options: 'local' (development) or 's3' (production object storage)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=storage

# S3 / Cloud Object Storage Settings (required only if STORAGE_BACKEND=s3)
S3_BUCKET_NAME=coldchain-sentinel-evidence
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# PayPal REST API Configuration (Sandbox)
# Mode: 'SANDBOX' or 'DEMO'
PAYPAL_MODE=SANDBOX
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_WEBHOOK_ID=

# AI Extraction & Explanation (Optional Gemini Integration)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Frontend Public Variables
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
